<?xml version="1.0" encoding="UTF-8"?>
<!--
	PHPUnit configuration for this sandbox.

	Requires PHPUnit 9+.

	Usage:
	 - "vendor/bin/phpunit": Runs the Default suite (app/tests)
	 - "vendor/bin/phpunit app/tests/SmokeTest.php": Run a single test
	 - "ddev test": Same as vendor/bin/phpunit, with extra args forwarded
-->
<phpunit bootstrap="vendor/silverstripe/framework/tests/bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="Default">
            <directory>app/tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
