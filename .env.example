# For a complete list of core environment variables see
# https://docs.silverstripe.org/en/5/getting_started/environment_management/#core-environment-variables

# DB credentials
SS_DATABASE_CLASS="MySQLDatabase"
SS_DATABASE_SERVER="localhost"
SS_DATABASE_USERNAME="<user>"
SS_DATABASE_PASSWORD="<password>"
SS_DATABASE_NAME="<database>"

# WARNING: in a live environment, change this to "live" instead of dev
SS_ENVIRONMENT_TYPE="dev"

# OAuth2 keys and settings. Keep private material out of git (.oauth/ is gitignored).
# Paths only — do not put PEM text in the environment. See README.md.
#   mkdir -p .oauth && openssl genrsa -out .oauth/private.key 2048
#   openssl rsa -in .oauth/private.key -pubout -out .oauth/public.key
#   chmod 600 .oauth/private.key
#   vendor/bin/generate-defuse-key   # paste into OAUTH2_ENCRYPTION_KEY
# The default JWKS list includes RsaKeyPair. That request opens the public file
# only. Signing opens the private file on first use. An empty public path, or a
# missing, unreadable, empty, or non-RSA public file, fails when the pair is
# constructed. A bad private path fails on first getPrivateKey().
# OAUTH2_PRIVATE_KEY_PATH=".oauth/private.key"
# OAUTH2_PUBLIC_KEY_PATH=".oauth/public.key"
# OAUTH2_PRIVATE_KEY_PASSPHRASE=""
# OAUTH2_ENCRYPTION_KEY=""
# OAUTH2_ISSUER="https://cms5-oauth2.ddev.site"
# Optional. Unset keeps the PHP defaults (/oauth, PT1H, P1M).
# OAUTH2_PATH_PREFIX="/oauth"
# OAUTH2_ACCESS_TOKEN_TTL="PT1H"
# OAUTH2_REFRESH_TOKEN_TTL="P1M"
