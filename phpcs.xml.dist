<?xml version="1.0"?>
<ruleset name="App">
    <description>PSR-12 for this sandbox</description>

    <file>app</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/thirdparty/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>

    <rule ref="PSR12"/>

    <!-- Installer Page classes and suite smoke tests stay global (Silverstripe convention). -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>app/src/Page.php</exclude-pattern>
        <exclude-pattern>app/src/PageController.php</exclude-pattern>
        <exclude-pattern>app/tests/SmokeTest.php</exclude-pattern>
        <exclude-pattern>app/tests/OAuth2SettingsTest.php</exclude-pattern>
        <exclude-pattern>app/tests/RsaPublicJsonWebKeyTest.php</exclude-pattern>
        <exclude-pattern>app/tests/PublishedJsonWebKeySetProviderTest.php</exclude-pattern>
    </rule>

    <!-- Silverstripe template actions such as Form() keep their CMS names. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>app/src/PageController.php</exclude-pattern>
    </rule>
</ruleset>
